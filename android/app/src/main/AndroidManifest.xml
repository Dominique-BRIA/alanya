<!-- `xmlns:tools` sert au `tools:replace` du service de localisation plus bas :
     sans lui, la fusion des manifestes échoue sur un attribut en conflit. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Appels entrants plein écran (Android 10+/14+) -->
    <!-- Écran d'appel plein écran, même téléphone verrouillé.
         Depuis Android 14, cette autorisation est REFUSÉE par défaut à toute
         application qui n'est pas reconnue comme application d'appel — ce qui
         explique qu'un même APK affiche l'appel sur un téléphone en Android 13
         et pas sur un Android 14. MANAGE_OWN_CALLS ci-dessous est ce qui range
         Alanya dans cette catégorie. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Déclare Alanya comme application gérant ses propres appels. C'est la
         permission qu'utilisent WhatsApp et les autres messageries pour que le
         système les traite comme un téléphone : elle conditionne l'octroi
         automatique de USE_FULL_SCREEN_INTENT sur Android 14 et suivants. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <!-- Android 13+ : permissions granulaires pour les médias -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- Requis pour flutter_webrtc sur Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Requis pour maintenir l'appel en arrière-plan -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Depuis Android 14, FOREGROUND_SERVICE ne suffit plus : chaque type de
         service exige SA permission. Sans celle-ci, démarrer le service d'appel
         lève une SecurityException et l'appel se coupe dès que l'application
         passe en arrière-plan. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- Même règle, pour les envois et téléchargements qui doivent survivre à la
         fermeture de l'application. ⚠️ Depuis Android 15, un service `dataSync`
         est plafonné à 6 h par jour cumulées : sans effet sur des transferts de
         fichiers, rédhibitoire pour un usage continu. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Empêche la mise en veille de la puce Wi-Fi pendant un appel : c'est elle
         qui coupe les connexions WebRTC quand l'écran s'éteint. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Relevé de position des agents rattachés à une entreprise (table `geo`).

         ⚠️ TROIS PERMISSIONS, ET ELLES NE SE DEMANDENT PAS ENSEMBLE. Android
         impose un parcours en deux temps : d'abord « pendant l'utilisation »
         (FINE + COARSE), et seulement ensuite « toujours autoriser »
         (BACKGROUND), qui s'obtient dans les réglages du système et non dans une
         boîte de dialogue. Les demander d'un bloc fait échouer la seconde en
         silence.

         COARSE accompagne obligatoirement FINE depuis Android 12 : sans elle, le
         système n'affiche que le choix « position approximative » et refuse la
         précision.

         ⚠️ `ACCESS_BACKGROUND_LOCATION` est la permission la plus examinée du
         Play Store. L'application partant en distribution PUBLIQUE, elle exige
         un formulaire de déclaration, une vidéo de démonstration, un écran de
         divulgation DANS l'application avant toute demande, et une politique de
         confidentialité publique. Voir `GeoDisclosureScreen`. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- Même règle que pour le micro : depuis Android 14, chaque type de service
         de premier plan exige SA permission. Sans celle-ci, démarrer le service
         de localisation lève une SecurityException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Reprend le relevé après un redémarrage du téléphone. Sans elle,
         `autoRunOnBoot` ne peut rien : la collecte s'arrêterait à l'extinction
         et ne repartirait qu'à la prochaine ouverture de l'application. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="Alanya Work"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- `singleTask` et NON `singleTop` : une seule instance de
             l'application peut exister, quel que soit le point d'entrée.
             `singleTop` ne dédoublonne que si l'activité est déjà EN HAUT DE LA
             MÊME PILE ; lancée depuis une notification ou l'écran d'appel
             natif, elle atterrissait dans une pile distincte et une seconde
             copie démarrait.

             ⚠️ `android:taskAffinity=""` a été RETIRÉ, et c'est le cœur du
             correctif. Une affinité vide détache l'activité de la tâche par
             défaut : l'icône du lanceur et un `PendingIntent` de notification
             ouvraient alors DEUX tâches. D'où les deux copies de l'application
             observées en arrière-plan — et le signal doublé, chacune tenant sa
             propre connexion WebSocket, ce qui coupait la sonnerie et bloquait
             sur « connexion en cours ».

             Cet attribut était là depuis le commit initial et ne figure PAS
             dans le gabarit Flutter standard. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Service qui maintient l'appel actif quand l'application quitte le
             premier plan. `foregroundServiceType` est OBLIGATOIRE depuis
             Android 10 pour capter le micro en arrière-plan, et doit
             correspondre au type passé à startForeground().
             `exported=false` : il n'est démarré que par l'application. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Maintient les envois et téléchargements quand l'application quitte
             l'écran, ou est balayée des tâches récentes.

             ⚠️ Service DISTINCT de celui de `flutter_foreground_task`, qui n'en
             expose qu'un seul et le déclare `foregroundServiceType="location"`
             pour le relevé de position. Le réutiliser aurait lié les deux :
             arrêter les transferts aurait arrêté la géolocalisation. -->
        <service
            android:name=".TransferForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Service de relevé de position, fourni par `flutter_foreground_task`.

             ⚠️ `tools:replace` EST INDISPENSABLE. Le paquet déclare son service
             dans SON propre manifeste, avec un type générique ; la fusion des
             manifestes garderait donc le sien, et Android refuserait de
             démarrer un service de localisation dont le type ne le dit pas.
             C'est ici qu'on impose `location`, et l'attribut ne peut être
             écrasé qu'explicitement.

             Le nom de classe vient du paquet — le changer casserait le
             démarrage sans le moindre message : le système chercherait un
             service qui n'existe pas. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:exported="false"
            android:foregroundServiceType="location"
            tools:replace="android:foregroundServiceType" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FileProvider : ouverture des fichiers téléchargés. L'autorité suit
             applicationId, donc elle devient com.alanya237.work.fileprovider
             sans rien changer ici. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
