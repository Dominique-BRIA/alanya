.idea/
.idea/
*.iml

# Cache de build Gradle. Il était versionné : ses fichiers .lock et .bin
# changent à chaque compilation, donc chaque build salissait `git status` et
# risquait d'entrer dans un commit sans qu'on le veuille. Rien là-dedans n'est
# reproductible d'une machine à l'autre.
android/.gradle/

# Sauvegardes d'éditeur. `chat_screen.dart.bak` était suivi et polluait toutes
# les recherches dans le code : deux résultats pour chaque occurrence, dont un
# dans une version périmée.
*.bak

# ⚠️ CLÉ DE SIGNATURE ET SON MOT DE PASSE — NE JAMAIS VERSIONNER.
# Quiconque possède ce fichier peut signer un APK au nom d'Alanya, donc publier
# une mise à jour que les téléphones installeront sans broncher. La clé se
# transmet par les secrets de la CI, jamais par le dépôt.
android/key.properties
*.jks
*.keystore

# Chemins du SDK, PROPRES À CHAQUE MACHINE. Ce fichier était versionné avec
# « /home/bria/Android/Sdk » et « /home/bria/development/flutter » : sur toute
# autre machine, la configuration Gradle échouait sur « Included build does not
# exist ». Flutter le régénère automatiquement à chaque build — c'est d'ailleurs
# pourquoi il ressortait modifié après chaque compilation.
android/local.properties

# ⚠️ SORTIE DE COMPILATION — NE JAMAIS VERSIONNER.
#
# Ces deux dossiers sont REGENERES par `flutter pub get` et `flutter build` a
# chaque fois. Ils etaient pourtant suivis, partiellement : 58 fichiers sous
# `build/`, 39 sous `.dart_tool/`, le reste ignore de personne. Un simple
# `git add -A` apres un `flutter test` y ajoutait alors une trentaine de
# fichiers de plus — dont une COPIE de tous les assets, ce qui a valu au depot
# l'avertissement « Large files detected » de GitHub le 08/09/2026.
#
# Rien ici n'est reproductible d'une machine a l'autre, et rien n'y est
# necessaire a la compilation : tout se regenere.
build/
.dart_tool/
